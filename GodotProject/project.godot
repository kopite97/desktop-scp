; Engine configuration file. Source project; no export configuration yet.
config_version=5

[application]
config/name="SCP: Site-Desktop"
run/main_scene="res://Scenes/App/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/per_pixel_transparency/allowed=true
window/size/viewport_width=640
window/size/viewport_height=420
window/size/window_width_override=640
window/size/window_height_override=420

[dotnet]
project/assembly_name="SiteDesktop"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.07, 0.085, 1)
